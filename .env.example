# Public donation / payment link (baked in at build time)
VITE_DONATE_URL=https://paypal.me/OwenJay450

# Shown in the Plus paywall UI (baked in at build time)
VITE_PLUS_PRICE=£1.99/month

# BODS API key (server-side only — primary live vehicle source for /api/vehicles)
BODS_API_KEY=

# BusMaps Pro API key (optional; not used while BODS is primary)
# Dashboard: https://busmaps.com — header auth: capi-key Bearer <key>
# BUSMAPS_API_KEY=

# TransportAPI (stop boards / service live — not a national bbox vehicle feed on public plans)
# https://developer.transportapi.com/
# TRANSPORTAPI_APP_ID=
# TRANSPORTAPI_APP_KEY=

# First Bus app gateway key (server-side only — /api/first-stop-times live seats
# and wheelchair counts for First Potteries cards)
FIRST_APP_KEY=

# Plus via PayPal Checkout (Orders API) — required to confirm payment
# Create an app at https://developer.paypal.com/dashboard/applications
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# PAYPAL_MODE=sandbox
PLUS_AMOUNT=1.99
PLUS_CURRENCY=GBP
PLUS_PRICE_LABEL=£1.99/month

# Optional Stripe instead of PayPal:
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_PRICE_ID=price_...

# Auth / accounts (Postgres on Railway) — Plus login only
# DATABASE_URL=${{Postgres.DATABASE_URL}}
# AUTH_SECRET=long-random-string

# Thank-you / proof-of-purchase emails after Plus payment (https://resend.com)
# RESEND_API_KEY=re_...
# MAIL_FROM=UK Bus Tracker <plus@yourdomain.com>
# PUBLIC_SITE_URL=https://ukbustracker.up.railway.app

# Plus bus photos: members upload → you approve at /admin-photos.html (uses AUTH_SECRET)
# Control-room notices: publish at /admin-notices.html (uses AUTH_SECRET)

# Full free PC hosting (no Railway required to serve the site):
#   powershell -ExecutionPolicy Bypass -File .\scripts\start-all-on-pc.ps1
# Data lives under .\data\ (Postgres + trails). Public URL via Cloudflare quick tunnel.
# TRAIL_REMOTE_URL=   (leave unset when the whole site runs on this PC)
