{
  "name": "uk-bus-tracker",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node server.mjs",
    "serve": "npm run build && npm start",
    "liveries:trainbasher": "node scripts/sync-trainbasher-liveries.mjs",
