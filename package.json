  },
  "engines": {
    "node": ">=22.5"
  },
  "dependencies": {
    "@mapbox/vector-tile": "^3.0.0",
    "compression": "^1.8.2",
    "embedded-postgres": "^18.4.0-beta.17",
    "express": "^5.1.0",
    "http-proxy-middleware": "^3.0.5",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "pbf": "^5.1.2",
    "pg": "^8.23.0",
    "sharp": "^0.35.4",
    "ssh2": "^1.17.0"
  },
  "devDependencies": {
    "vite": "^7.1.5"
  },
  "allowScripts": {
    "@embedded-postgres/windows-x64@18.4.0-beta.17": true,
    "esbuild@0.28.2": true
  }
